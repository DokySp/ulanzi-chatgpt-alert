{
  "Version": "1.2.0",
  "Author": "Personal",
  "Name": "ChatGPT 알림",
  "Description": "ChatGPT Windows 앱의 알림 애니메이션과 계정 사용량 게이지를 표시합니다.",
  "Icon": "resources/idle.png",
  "CodePath": "plugin/bootstrap.js",
  "Type": "JavaScript",
  "UUID": "com.ulanzi.ulanzistudio.chatgptalert",
  "OS": [
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Software": { "MinVersion": "3.4.8" },
  "Actions": [
    {
      "Name": "ChatGPT 알림",
      "Icon": "resources/idle.png",
      "Tooltip": "완료·입력 요청 시 선택한 효과가 반복됩니다. 버튼을 누르거나 ChatGPT 앱으로 돌아가면 멈춥니다.",
      "UUID": "com.ulanzi.ulanzistudio.chatgptalert.alert",
      "PropertyInspectorPath": "property-inspector/inspector.html",
      "Controllers": ["Keypad"],
      "Devices": ["D200X"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "state": 0,
      "States": [
        { "Name": "대기", "Image": "resources/idle.png" },
        { "Name": "알림 켜짐", "Image": "resources/on.png" },
        { "Name": "알림 꺼짐", "Image": "resources/off.png" }
      ]
    },
    {
      "Name": "ChatGPT 사용량",
      "Icon": "resources/usage.png",
      "Tooltip": "계정의 Codex 사용률과 초기화 시간을 표시합니다. 버튼을 누르면 새로고침합니다.",
      "UUID": "com.ulanzi.ulanzistudio.chatgptalert.usage",
      "PropertyInspectorPath": "property-inspector/usage.html",
      "Controllers": ["Keypad"],
      "Devices": ["D200X"],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "state": 0,
      "States": [{ "Name": "사용량", "Image": "resources/usage.png" }]
    }
  ]
}
